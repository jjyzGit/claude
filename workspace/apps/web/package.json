{
  "name": "@sollapay/web",
  "version": "0.2.1-dev.7",
  "private": true,
  "description": "Sollapay web - React SPA with Auth0 and React Router",
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "build-storybook": "storybook build",
    "clean": "rm -rf dist",
