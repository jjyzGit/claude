    "@sollapay/types": "workspace:*",
    "@sollapay/ui": "workspace:*",
    "@sollapay/utils": "workspace:*",
    "@tanstack/react-query": "^5.62.11",
    "exceljs": "^4.4.0",
    "i18next": "^25.7.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.66.0",
    "react-i18next": "^16.5.3",
    "react-router-dom": "^7.12.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.0.1",
    "@sollapay/eslint-config": "workspace:*",
