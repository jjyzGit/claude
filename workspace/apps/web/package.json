    "format": "sort-package-json && prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6007",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.2.4",
    "@sollapay/domain": "workspace:*",
